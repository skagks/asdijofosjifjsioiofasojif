+def resize_mode() -> str:
+    """The resize mode in effect: RESIZE_MODE, or "off" when RESIZE_FREEZE is False."""
+    if not RESIZE_FREEZE:
+        return "off"
+    return RESIZE_MODE if RESIZE_MODE in RESIZE_MODES else "freeze"
+
